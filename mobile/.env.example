# Address of the AIDA Mobile Bridge running on the desktop.
# Use the desktop's LAN IP address, not localhost, when testing on a phone/tablet.
EXPO_PUBLIC_AIDA_API_URL=http://192.168.1.100:8765

# Early Alpha pairing token. This is a local development credential, not a
# production-grade device identity. It must match AIDA_MOBILE_TOKEN on desktop.
EXPO_PUBLIC_AIDA_PAIRING_TOKEN=replace-with-a-long-random-token
