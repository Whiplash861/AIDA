# AIDA Mobile Services Gateway
#
# Public production gateway URL. This value may be embedded in the application
# because it is only an HTTPS service address, not a credential.
# Example:
# EXPO_PUBLIC_AIDA_GATEWAY_URL=https://aida-services.example.azurecontainerapps.io
EXPO_PUBLIC_AIDA_GATEWAY_URL=

# Development-only values below are normally generated automatically by
# scripts/start-mobile-dev.ps1 in ignored mobile/.env.local for one session.
# Do not commit real values and do not use them for Play builds.
EXPO_PUBLIC_AIDA_DEV_GATEWAY_URL=
EXPO_PUBLIC_AIDA_DEV_GATEWAY_TOKEN=

# IMPORTANT:
# Never place Azure OpenAI, OpenAI, ElevenLabs, AIDA gateway bearer/session
# secrets, passwords, private keys, or other provider credentials in any
# EXPO_PUBLIC_* variable. EXPO_PUBLIC values are application-visible.
