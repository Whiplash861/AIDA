# AIDA bug reporting
# Optional override for the registered developer mailbox.
# No sender account, password, API key, subscription, or cloud registration is required.
AIDA_BUG_REPORT_RECIPIENT=AIDAdeveloper@outlook.com

# Optional Phase 1 voice transcription.
# Audio is captured to a temporary local WAV file and is not stored in AIDA memory.
OPENAI_API_KEY=
AIDA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Artificer Engine — Early Alpha safe defaults.
# Operational telemetry remains on the local device unless the owner explicitly
# changes consent and configures an authorized encrypted receiver.
AIDA_ARTIFICER_ENABLED=true
AIDA_ARTIFICER_MODE=early_alpha
AIDA_ARTIFICER_TELEMETRY_LEVEL=local_only
AIDA_ARTIFICER_AUTO_MAINTENANCE_ENABLED=false
AIDA_ARTIFICER_LOCAL_EXPORT_ENABLED=true
AIDA_ARTIFICER_REVIEW_INTERVAL_SECONDS=21600
AIDA_ARTIFICER_DISPATCH_ENDPOINT=
