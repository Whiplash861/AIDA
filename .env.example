# AIDA bug reporting
# The sender and destination mailbox addresses are not secrets.
AIDA_BUG_REPORT_SENDER=AIDAdeveloper@outlook.com
AIDA_BUG_REPORT_RECIPIENT=AIDAdeveloper@outlook.com

# Create a SendGrid API key with Mail Send permission only.
# Never commit the real key. Keep it in the local .env file.
AIDA_SENDGRID_API_KEY=
